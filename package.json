{
  "name": "@step-security/xcode-select-version-action",
  "version": "1.1.0",
  "description": "Selects an installed Xcode version on a GitHub Actions runner.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "ncc build src/index.ts -o dist --minify",
    "all": "npm run typecheck && npm run test && npm run build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/step-security/xcode-select-version-action.git"
  },
  "keywords": [
    "xcode",
    "version",
    "action",
    "github",
    "actions",
    "workflow"
  ],
  "author": "step-security",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/step-security/xcode-select-version-action/issues"
  },
  "homepage": "https://github.com/step-security/xcode-select-version-action#readme",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@vercel/ncc": "0.45.0",
    "typescript": "5.9.3",
    "vitest": "^3.2.7"
  }
}
